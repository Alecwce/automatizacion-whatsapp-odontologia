---
// Testimonials: Sección de testimonios de pacientes locales en formato Google Reviews (Prueba Social).
interface Testimonial {
  stars: number;
  text: string;
  author: string;
  location: string;
  initials: string;
  avatarBg: string;
  date: string;
}

const testimonials: Testimonial[] = [
  {
    stars: 5,
    text: "Excelente atención y explicación detallada. La doctora me guio en todo mi tratamiento de ortodoncia invisible con mucha paciencia. ¡Las instalaciones en El Tambo son de primer nivel!",
    author: "María Fernández",
    location: "El Tambo, Huancayo",
    initials: "MF",
    avatarBg: "bg-violet-700",
    date: "Hace una semana",
  },
  {
    stars: 5,
    text: "Tuve una emergencia dental un sábado por la noche y el bot de WhatsApp me agendó la cita de inmediato. La atención del staff fue muy rápida y eficiente. Vine desde Chupaca y valió totalmente la pena.",
    author: "Carlos Rojas",
    location: "Chupaca, Junín",
    initials: "CR",
    avatarBg: "bg-violet-600",
    date: "Hace un mes",
  },
  {
    stars: 5,
    text: "Instalaciones impecables y modernas. Me realizaron una endodoncia rotatoria y no sentí absolutamente nada de dolor. Es sin duda la mejor clínica dental de Huancayo por su tecnología.",
    author: "Ana Luz",
    location: "Huancayo Centro",
    initials: "AL",
    avatarBg: "bg-violet-800",
    date: "Hace 2 semanas",
  },
];
---

<section class="py-20 sm:py-24 bg-gray-50 border-t border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la sección -->
    <div class="text-center mb-16 flex flex-col items-center">
      <p class="text-sm font-bold text-violet-700 uppercase tracking-widest mb-3">
        Opiniones Reales
      </p>
      <h2 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-4 flex items-center gap-2">
        Excelente <span class="text-violet-700">4.9/5</span>
      </h2>
      <div class="flex items-center gap-1.5 mb-3" aria-label="Calificación de 5 estrellas de Google Reviews">
        <span class="text-yellow-400 text-2xl">★</span>
        <span class="text-yellow-400 text-2xl">★</span>
        <span class="text-yellow-400 text-2xl">★</span>
        <span class="text-yellow-400 text-2xl">★</span>
        <span class="text-yellow-400 text-2xl">★</span>
      </div>
      <p class="text-sm text-gray-500 font-medium">
        Basado en opiniones reales registradas en Google Reviews
      </p>
    </div>

    <!-- Grid de testimonios -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <article class="relative bg-white rounded-3xl p-8 border border-gray-100/80 shadow-md hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
          
          <!-- Logo de Google en la esquina superior derecha -->
          <svg class="w-5 h-5 absolute top-6 right-6 select-none opacity-85" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>

          <div>
            <!-- Estrellas de Calificación -->
            <div class="flex items-center gap-1 mb-5" aria-label="Calificación de 5 estrellas">
              {Array.from({ length: t.stars }).map(() => (
                <span class="text-yellow-400 text-lg">★</span>
              ))}
            </div>
            
            <!-- Texto del testimonio -->
            <blockquote class="text-gray-600 text-sm leading-relaxed italic pr-4">
              "{t.text}"
            </blockquote>
          </div>

          <!-- Perfil del Paciente -->
          <div class="flex items-center justify-between mt-8 border-t border-gray-50 pt-5">
            <div class="flex items-center gap-3">
              <div class={`w-10 h-10 rounded-full ${t.avatarBg} flex items-center justify-center text-white font-extrabold text-sm shadow-sm`} aria-hidden="true">
                {t.initials}
              </div>
              <div>
                <cite class="not-italic text-sm font-bold text-gray-900 block">{t.author}</cite>
                <span class="text-[10px] text-gray-400 font-semibold block">{t.location}</span>
              </div>
            </div>
            <span class="text-[10px] text-gray-400 font-medium">{t.date}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

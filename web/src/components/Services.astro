---
// Services: Grid responsive de 6 tarjetas de servicios odontológicos reales.
interface Service {
  icon: string;
  title: string;
  description: string;
}

const services: Service[] = [
  {
    icon: '🔍',
    title: 'Diagnóstico',
    description: 'Evaluación integral, radiografías de alta precisión y diseño de un plan de tratamiento personalizado a tu medida.',
  },
  {
    icon: '✨',
    title: 'Estética Dental',
    description: 'Diseño de sonrisa, carillas de porcelana y técnicas avanzadas de blanqueamiento para lograr una sonrisa radiante y natural.',
  },
  {
    icon: '👶',
    title: 'Odontopediatría',
    description: 'Cuidado dental especializado para los más pequeños, en un ambiente divertido, cálido y completamente libre de estrés.',
  },
  {
    icon: '🦷',
    title: 'Ortodoncia',
    description: 'Brackets metálicos, estéticos y alineadores invisibles de última generación para alinear tus dientes y mejorar tu mordida.',
  },
  {
    icon: '🔬',
    title: 'Cirugía e Implantes',
    description: 'Restauración de piezas faltantes con implantes de titanio y cirugías reconstructivas mediante técnicas mínimamente invasivas.',
  },
  {
    icon: '🩺',
    title: 'Odontología Integral',
    description: 'Profilaxis profunda, curación de caries, endodoncias y prótesis para devolver la funcionalidad y salud completa a tu boca.',
  },
];
---

<section class="py-20 sm:py-28 bg-gray-50/55">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Encabezado de sección -->
    <div class="text-center mb-16">
      <p class="text-sm font-bold text-violet-700 uppercase tracking-widest mb-3">
        Especialidades Médicas
      </p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight leading-tight">
        Cuidamos tu salud bucal <br class="hidden sm:block" />con tratamientos especializados
      </h2>
    </div>

    <!-- Grid de tarjetas (3 columnas en pantallas grandes) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <article class="group bg-white rounded-2xl p-8 border border-gray-100 border-t-4 border-violet-600 shadow-sm hover:shadow-xl hover:border-t-violet-800 transition-all duration-300 hover:-translate-y-2 flex flex-col justify-between">
          <div>
            <!-- Ícono en contenedor circular -->
            <div
              class="w-14 h-14 rounded-full bg-violet-50 flex items-center justify-center text-2xl mb-6 group-hover:bg-violet-700 group-hover:text-white group-hover:scale-110 transition-all duration-300 shadow-inner"
              aria-hidden="true"
            >
              {service.icon}
            </div>

            <!-- Título -->
            <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-violet-700 transition-colors duration-200">
              {service.title}
            </h3>

            <!-- Descripción -->
            <p class="text-sm text-gray-600 leading-relaxed">
              {service.description}
            </p>
          </div>

          <!-- Link sutil de llamada a la acción -->
          <div class="mt-6 pt-4 border-t border-gray-50 flex items-center gap-1 text-xs font-bold text-violet-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            Consultar especialidad 
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.97H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

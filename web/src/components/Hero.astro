---
// Hero Section: Eslogan de impacto + CTA de WhatsApp con URLSearchParams.
const phone = '51900000000';
const message = 'Hola JOMOVAK, quiero agendar una cita odontológica.';
const params = new URLSearchParams({ text: message });
const whatsappUrl = `https://wa.me/${phone}?${params.toString()}`;
---

<section id="inicio" class="relative overflow-hidden bg-white pt-20 pb-20 sm:pt-28 sm:pb-28 animate-fade-in">

  <!-- Fondo decorativo sutil -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-0 right-0 w-96 h-96 bg-violet-50 rounded-full -translate-y-1/2 translate-x-1/3 opacity-60"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-violet-50 rounded-full translate-y-1/3 -translate-x-1/4 opacity-40"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Contenido de texto -->
      <div class="lg:col-span-7">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-violet-50 text-violet-700 text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-violet-600 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-violet-700"></span>
          </span>
          Clínica Dental Avanzada
        </div>

        <!-- Titular principal -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 leading-tight tracking-tight mb-6">
          Tu salud bucal en<br />
          <span class="text-violet-700">manos de especialistas</span>.
        </h1>

        <!-- Subtítulo -->
        <p class="text-lg sm:text-xl text-gray-600 leading-relaxed mb-10 max-w-2xl">
          En la Clínica JOMOVAK cuidamos tu sonrisa con profesionales calificados y tecnología de vanguardia. Agenda tu cita directamente por WhatsApp con nuestro asistente virtual disponible 24/7.
        </p>

        <!-- CTA Principal -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <a
            id="hero-cta-whatsapp"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 bg-violet-700 hover:bg-violet-800 text-white font-bold text-base px-7 py-4 rounded-2xl shadow-lg shadow-violet-200 transition-all duration-200 hover:shadow-xl hover:shadow-violet-300 hover:-translate-y-1"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 transition-transform duration-200 group-hover:scale-110"
              aria-hidden="true"
            >
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Agendar Cita por WhatsApp
          </a>

          <p class="text-sm text-gray-500 flex items-center gap-1.5 py-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-emerald-500" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            Sin costo · Respuesta inmediata
          </p>
        </div>
      </div>

      <!-- Imagen del logo oficial -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative group">
          <!-- Resplandor decorativo -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-violet-600 to-indigo-500 rounded-3xl blur-2xl opacity-15 group-hover:opacity-25 transition duration-1000"></div>
          
          <!-- Contenedor -->
          <div class="relative p-1.5 rounded-[32px] bg-gradient-to-tr from-violet-100 via-white to-violet-50 shadow-2xl shadow-violet-200/50">
            <div class="relative bg-white/90 backdrop-blur-md p-6 sm:p-8 rounded-[26px] border border-violet-50/50 max-w-sm overflow-hidden flex items-center justify-center">
              <img
                src="/jomovak.png"
                alt="Clínica Odontológica JOMOVAK Logo"
                class="w-full h-auto max-h-[320px] object-contain transition-transform duration-500 hover:scale-102"
                loading="eager"
                decoding="async"
              />
            </div>
            <!-- Badge -->
            <div class="absolute -top-2.5 -right-2.5 z-10 bg-white text-violet-700 font-extrabold text-xs px-3.5 py-1.5 rounded-full shadow-md border border-violet-100/80 animate-pulse flex items-center gap-1 select-none">
              Atención Rápida ⚡
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

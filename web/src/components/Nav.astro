---
// Nav: Barra superior fija con logo de Consultorio Sánchez, menú corporativo premium y botón de cita.
const whatsappUrl = 'https://wa.me/51981314450?text=Hola%20quiero%20agendar';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm transition-all duration-300">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between" aria-label="Navegación principal">

    <!-- Logo Consultorio Sánchez -->
    <a href="/" class="flex items-center focus:outline-none" aria-label="Ir al inicio - Consultorio Sánchez">
      <img src="/logo-header.png" alt="Logotipo Consultorio Sánchez" class="h-12 w-auto object-contain" />
    </a>

    <!-- Menú de Escritorio (md en adelante) -->
    <div class="hidden md:flex items-center gap-8">
      <a href="/" class="text-sm font-semibold text-gray-600 hover:text-violet-700 transition-colors duration-200">INICIO</a>
      
      <!-- Dropdown Nosotros (Hover) -->
      <div class="relative group py-2">
        <a 
          href="/nosotros"
          class="flex items-center gap-1.5 text-sm font-semibold text-gray-600 hover:text-violet-700 transition-colors duration-200 focus:outline-none cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
        >
          NOSOTROS
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-gray-400 group-hover:text-violet-700 group-hover:rotate-180 transition-transform duration-200" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </a>
        <!-- Panel Dropdown -->
        <div class="absolute left-1/2 -translate-x-1/2 mt-2 w-48 bg-white rounded-xl shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 py-2 pointer-events-none group-hover:pointer-events-auto">
          <a href="/nosotros#quienes-somos" class="block px-4 py-2 text-sm text-gray-700 hover:bg-violet-50 hover:text-violet-700 font-medium transition-colors duration-150">Quiénes Somos</a>
          <a href="/nosotros#staff" class="block px-4 py-2 text-sm text-gray-700 hover:bg-violet-50 hover:text-violet-700 font-medium transition-colors duration-150">Dra. Luisa Sánchez</a>
          <a href="/nosotros#tecnologia" class="block px-4 py-2 text-sm text-gray-700 hover:bg-violet-50 hover:text-violet-700 font-medium transition-colors duration-150">Nuestra Tecnología</a>
        </div>
      </div>

      <a href="/servicios" class="text-sm font-semibold text-gray-600 hover:text-violet-700 transition-colors duration-200">NUESTROS SERVICIOS</a>
      <a href="/contacto" class="text-sm font-semibold text-gray-600 hover:text-violet-700 transition-colors duration-200">CONTACTO</a>
    </div>

    <!-- Botón Reservar Cita (Escritorio) -->
    <div class="hidden md:block">
      <a
        id="nav-cta-whatsapp"
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center bg-violet-700 hover:bg-violet-800 text-white text-xs font-extrabold px-6 py-3.5 rounded-full transition-all duration-200 hover:shadow-lg hover:shadow-violet-200 hover:-translate-y-0.5 tracking-wider uppercase"
      >
        RESERVE SU CITA
      </a>
    </div>

    <!-- Botón Menú Móvil (Hambuguesa / Cerrar) -->
    <button
      id="mobile-menu-button"
      class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 focus:outline-none cursor-pointer"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 hidden">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Menú Móvil Desplegable -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-gray-100 bg-white/95 backdrop-blur-md transition-all duration-300 shadow-inner"
  >
    <div class="px-4 pt-2 pb-6 space-y-3">
      <a href="/" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-gray-700 hover:bg-violet-50 hover:text-violet-700 transition-colors">INICIO</a>
      
      <!-- Subsección Nosotros en Móvil -->
      <div class="px-3 py-1.5">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">NOSOTROS</p>
        <div class="pl-4 border-l border-violet-100 space-y-2.5">
          <a href="/nosotros#quienes-somos" class="mobile-nav-link block text-sm font-semibold text-gray-600 hover:text-violet-700 transition-colors">Quiénes Somos</a>
          <a href="/nosotros#staff" class="mobile-nav-link block text-sm font-semibold text-gray-600 hover:text-violet-700 transition-colors">Dra. Luisa Sánchez</a>
          <a href="/nosotros#tecnologia" class="mobile-nav-link block text-sm font-semibold text-gray-600 hover:text-violet-700 transition-colors">Nuestra Tecnología</a>
        </div>
      </div>

      <a href="/servicios" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-gray-700 hover:bg-violet-50 hover:text-violet-700 transition-colors">NUESTROS SERVICIOS</a>
      <a href="/contacto" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-gray-700 hover:bg-violet-50 hover:text-violet-700 transition-colors">CONTACTO</a>
      
      <!-- Botón Reservar Cita (Móvil) -->
      <div class="pt-4 px-3">
        <a
          id="mobile-nav-cta-whatsapp"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center w-full bg-violet-700 hover:bg-violet-800 text-white text-sm font-extrabold py-3.5 rounded-full shadow-md shadow-violet-100 transition-all duration-200 tracking-wider uppercase"
        >
          RESERVE SU CITA
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Script interactivo para el menú móvil de Astro
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isExpanded = mobileMenuButton?.getAttribute('aria-expanded') === 'true';
    mobileMenuButton?.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }

  mobileMenuButton?.addEventListener('click', toggleMenu);

  // Cerrar el menú automáticamente al hacer clic en cualquier enlace interno
  mobileNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>

---
// Footer: Derechos reservados y créditos de la clínica.
const currentYear = new Date().getFullYear();
---

<footer id="footer" class="bg-gray-900 text-gray-400 py-8">
  <div class="flex flex-col md:flex-row justify-between items-center max-w-7xl mx-auto px-4 gap-4 w-full">

    <!-- Logo y marca -->
    <div class="flex items-center">
      <img
        src="/jomovak.png"
        alt="Logo JOMOVAK"
        class="h-[40px] w-auto object-contain"
      />
    </div>

    <!-- Copyright -->
    <p class="text-gray-400 text-sm text-center">
      &copy; {currentYear} Clínica Odontológica JOMOVAK. Todos los derechos reservados.
    </p>

    <!-- Ubicación -->
    <p class="text-gray-400 text-sm">
      Huancayo, Perú
    </p>

  </div>
</footer>

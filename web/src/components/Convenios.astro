---
// Convenios: Listado de marcas aseguradoras en un grid elegante de logotipos corporativos simulados.
interface Insurance {
  name: string;
  brandName: string;
  brandSubName?: string;
  textColorClass: string;
}

const insurances: Insurance[] = [
  { name: 'RIMAC Seguros', brandName: 'RIMAC', brandSubName: 'SEGUROS', textColorClass: 'text-red-600' },
  { name: 'MAPFRE', brandName: 'MAPFRE', textColorClass: 'text-red-700' },
  { name: 'Pacífico Seguros', brandName: 'Pacífico', brandSubName: 'SEGUROS', textColorClass: 'text-blue-500' },
  { name: 'SIGMA', brandName: 'SIGMA', textColorClass: 'text-emerald-600' },
  { name: 'Sanitas', brandName: 'Sanitas', textColorClass: 'text-blue-800' },
];
---

<section class="py-16 sm:py-24 bg-gray-50/30 border-t border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Encabezado de la sección -->
    <div class="text-center mb-12">
      <h2 class="text-xs font-bold text-violet-700 uppercase tracking-widest mb-3">
        Alianzas Estratégicas
      </h2>
      <p class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
        Nuestros Convenios
      </p>
      <p class="text-sm text-gray-500 mt-2 max-w-xl mx-auto">
        Atiéndete con la cobertura de tu seguro privado de salud en cualquiera de nuestras sedes.
      </p>
    </div>

    <!-- Grid de Aseguradoras -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-6 items-center justify-center">
      {insurances.map((ins) => (
        <div class="group bg-white rounded-2xl p-6 h-24 flex items-center justify-center shadow-md hover:-translate-y-1 hover:shadow-xl transition-all duration-300 select-none">
          <div class="flex flex-col items-center justify-center text-center">
            <!-- Simulación de Logo corporativo -->
            <span class={`font-black text-2xl tracking-tight transition-colors duration-300 ${ins.textColorClass}`}>
              {ins.brandName}
            </span>
            {ins.brandSubName && (
              <span class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mt-0.5 transition-colors duration-300">
                {ins.brandSubName}
              </span>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

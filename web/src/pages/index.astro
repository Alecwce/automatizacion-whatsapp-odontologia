---
// Landing Page — Portada de la Clínica Odontológica JOMOVAK
// Source: https://docs.astro.build/en/basics/astro-pages/
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import HomeInfo from '../components/HomeInfo.astro';
import HomeServicesPreview from '../components/HomeServicesPreview.astro';
import TechSection from '../components/TechSection.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Clínica Odontológica JOMOVAK — Agenda tu cita por WhatsApp"
  description="Clínica odontológica moderna con bot de IA 24/7. Agenda tu cita por WhatsApp en segundos. Limpieza, ortodoncia, endodoncia y restauraciones en Huancayo, Perú."
>
  <Nav />
  <main>
    <!-- Portada del Sitio con Carrusel de Imágenes Premium -->
    <div id="top">
      <HeroCarousel />
    </div>

    <!-- Información Corporativa y Horario Local de Huancayo -->
    <HomeInfo />

    <!-- Vista Previa de Especialidades y Servicios Clínicos -->
    <HomeServicesPreview />

    <!-- Simulación del Bot de Inteligencia Artificial -->
    <div id="tecnologia">
      <TechSection />
    </div>

    <!-- Testimonios de Pacientes (Prueba Social de Google Reviews) -->
    <Testimonials />
  </main>
  <Footer />
</Layout>

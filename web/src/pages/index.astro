---
// Landing Page — Clínica Odontológica JOMOVAK
// Source: https://docs.astro.build/en/basics/astro-pages/
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Values from '../components/Values.astro';
import TechSection from '../components/TechSection.astro';
import Testimonials from '../components/Testimonials.astro';
import Convenios from '../components/Convenios.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Clínica Odontológica JOMOVAK — Agenda tu cita por WhatsApp"
  description="Clínica odontológica moderna con bot de IA 24/7. Agenda tu cita por WhatsApp en segundos. Limpieza, ortodoncia, endodoncia y restauraciones en Huancayo, Perú."
>
  <Nav />
  <main>
    <!-- Contenedor de Inicio y Horarios -->
    <div id="top">
      <Hero />
    </div>

    <!-- Contenedor Quiénes Somos / Identidad y Valores -->
    <div id="nosotros">
      <Values />
    </div>

    <!-- Contenedor Catálogo de Servicios Especializados -->
    <div id="servicios">
      <Services />
    </div>

    <!-- Contenedor Tecnología -->
    <div id="tecnologia">
      <TechSection />
    </div>

    <!-- Contenedor Staff y Testimonios -->
    <div id="staff">
      <Testimonials />
    </div>

    <!-- Contenedor Alianzas y Convenios -->
    <div id="convenios">
      <Convenios />
    </div>
  </main>
  <Footer />
</Layout>

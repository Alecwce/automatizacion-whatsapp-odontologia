import Nav from '../components/Nav.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import TechSection from '../components/TechSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Clínica Odontológica JOMOVAK — Agenda tu cita por WhatsApp"
  description="Clínica odontológica moderna con bot de IA 24/7. Agenda tu cita por WhatsApp en segundos. Limpieza, ortodoncia, endodoncia y restauraciones en Huancayo, Perú."
>
  <Nav />
  <main>
    <!-- Portada del Sitio con Carrusel de Imágenes Premium -->
    <div id="top">
      <HeroCarousel />
    </div>

    <!-- Simulación del Bot de Inteligencia Artificial -->
    <div id="tecnologia">
      <TechSection />
    </div>
  </main>
  <Footer />
</Layout>

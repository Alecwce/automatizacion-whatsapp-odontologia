---
// Source: https://docs.astro.build/en/guides/styling/#import-a-local-stylesheet
// Los estilos globales se importan en el frontmatter para que Vite los procese.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Clínica Dental JOMOVAK | Huancayo',
  description = 'Clínica odontológica moderna con automatización inteligente. Agenda tu cita por WhatsApp en segundos. Limpieza, ortodoncia, endodoncia y más en Huancayo, Perú.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Favicon Premium -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦷</text></svg>">
    <link rel="apple-touch-icon" href="https://raw.githubusercontent.com/Alexwce/automatizacion-whatsapp-odontologia/main/web/public/apple-touch-icon.png" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased bg-white text-gray-900 min-h-screen flex flex-col">
    <slot />
  </body>
</html>

